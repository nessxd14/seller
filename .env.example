VITE_SUPABASE_URL=https://zxoxougwgstrarwymlvd.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# scripts/bootstrap_clientes.mjs only (one-off local script, not used by the built app).
# Direct Postgres connection string — get the real one from the Supabase project's
# Database settings (Connection string), NOT the same thing as VITE_SUPABASE_URL above.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Integración de saldo real POS <-> Hermes (api/hermes/*.ts). SIN prefijo VITE_ a
# propósito: estas dos solo las leen las funciones serverless de /api (process.env del
# lado del servidor de Vercel), nunca el bundle del navegador. En Vercel se cargan en
# seller -> Settings -> Environment Variables, HERMES_SERVICE_ROLE_KEY marcada
# "Sensitive". Nunca la anon key de Hermes acá — tiene que ser la service_role.
HERMES_URL=https://vlthlcbcgvsrwxqazvne.supabase.co
HERMES_SERVICE_ROLE_KEY=your-hermes-service-role-key
