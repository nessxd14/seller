VITE_SUPABASE_URL=https://zxoxougwgstrarwymlvd.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# scripts/bootstrap_clientes.mjs only (one-off local script, not used by the built app).
# Direct Postgres connection string — get the real one from the Supabase project's
# Database settings (Connection string), NOT the same thing as VITE_SUPABASE_URL above.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Saldo, crédito, reparto y cobros habituales usan RPC autenticadas en Cation.
# Estas variables sin VITE_ se conservan solo para endpoints de servidor heredados.
# No son necesarias para las RPC habituales. Nunca publicar claves de servicio.
HERMES_URL=https://zxoxougwgstrarwymlvd.supabase.co
# Esquema de la cartera en el mismo proyecto que el POS.
HERMES_SCHEMA=hermes
HERMES_SERVICE_ROLE_KEY=your-hermes-service-role-key

# Recuperación heredada manual: ya no se programa sync-despachos en vercel.json.
# Los nuevos despachos se procesan en la transacción de base de datos.
CATION_SERVICE_ROLE_KEY=your-cation-service-role-key

# Credencial del endpoint de recuperación heredado, si se usa manualmente.
CRON_SECRET=your-cron-secret

# Brief Caja-2 A3 — el scraper de BNB QR nunca tiene sesión de usuario del Seller, así
# que api/caja/ingestar-pagos-qr.ts se protege con este secreto compartido dedicado (no
# la service_role, no la anon key — regla del proyecto: un secreto por endpoint). Se
# manda en el header x-ingest-secret. Configurarla en Vercel -> Settings -> Environment
# Variables, marcada "Sensitive", y en config.env del scraper (proyecto separado).
QR_INGEST_SECRET=your-qr-ingest-secret

# Brief Caja-2 B3 — auditoría de DVR (Part del relay Python, proyecto separado). Sin
# configurar, src/lib/auditoriaDvr.ts es un no-op total: así los previews de Vercel y
# cualquier PC sin este env var nunca emiten /start ni /end por accidente.
VITE_AUDIT_API_URL=http://localhost:8787
# Opcional — sin configurar, cae al nombre de la caja.
VITE_AUDIT_CAJA_ID=Caja Tienda
